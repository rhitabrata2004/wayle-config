#!/usr/bin/env python3
"""Live weather for the wayle bar, auto-located from the current public IP.

Geolocation is cached (IP rarely changes) and refreshed every 6h; the
weather itself is re-fetched on every invocation (driven by the custom
module's poll interval). Outputs JSON consumed by wayle's custom module:
`text` becomes the label, `tooltip` the hover text, `alt` picks the icon
via `icon-map` in config.toml.

Network calls are retried a couple of times with a short backoff, since
this machine has been observed to still be resolving DNS in the first
seconds after boot/resume -- exactly when wayle's bar starts polling.
If every retry still fails, the last successful reading is served from
a small cache (tagged "last known") instead of blanking the bar to
"--deg", since wayle's poll interval (15 min) means a single dropped
request would otherwise leave the bar stuck for a long time.
"""

import json
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path

GEO_CACHE = Path.home() / ".cache" / "wayle-weather-geo.json"
GEO_TTL_SECONDS = 6 * 60 * 60
RESULT_CACHE = Path.home() / ".cache" / "wayle-weather-last.json"
TIMEOUT = 5
RETRIES = 3
RETRY_BACKOFF_SECONDS = 1.5

# WMO weather code -> (description, alt key used for icon-map lookup)
WMO_CODES = {
    0: ("Clear sky", "clear"),
    1: ("Mainly clear", "partly"),
    2: ("Partly cloudy", "partly"),
    3: ("Overcast", "cloudy"),
    45: ("Fog", "fog"),
    48: ("Depositing rime fog", "fog"),
    51: ("Light drizzle", "drizzle"),
    53: ("Drizzle", "drizzle"),
    55: ("Dense drizzle", "drizzle"),
    56: ("Freezing drizzle", "drizzle"),
    57: ("Dense freezing drizzle", "drizzle"),
    61: ("Slight rain", "rain"),
    63: ("Rain", "rain"),
    65: ("Heavy rain", "rain"),
    66: ("Freezing rain", "rain"),
    67: ("Heavy freezing rain", "rain"),
    71: ("Slight snow", "snow"),
    73: ("Snow", "snow"),
    75: ("Heavy snow", "snow"),
    77: ("Snow grains", "snow"),
    80: ("Slight rain showers", "rain"),
    81: ("Rain showers", "rain"),
    82: ("Violent rain showers", "rain"),
    85: ("Slight snow showers", "snow"),
    86: ("Heavy snow showers", "snow"),
    95: ("Thunderstorm", "storm"),
    96: ("Thunderstorm, slight hail", "storm"),
    99: ("Thunderstorm, heavy hail", "storm"),
}


def fetch_json(url):
    """Fetch and parse JSON, retrying transient network errors.

    Boot-time DNS not being up yet, or a dropped connection, are both
    transient -- worth a couple of quick retries before giving up,
    rather than surfacing failure on the first hiccup.
    """
    req = urllib.request.Request(url, headers={"User-Agent": "wayle-weather-auto"})
    last_error = None
    for attempt in range(RETRIES):
        try:
            with urllib.request.urlopen(req, timeout=TIMEOUT) as resp:
                return json.loads(resp.read())
        except (urllib.error.URLError, TimeoutError, OSError) as e:
            last_error = e
            if attempt < RETRIES - 1:
                time.sleep(RETRY_BACKOFF_SECONDS)
    raise last_error


def get_location():
    try:
        if GEO_CACHE.exists():
            cached = json.loads(GEO_CACHE.read_text())
            if time.time() - cached.get("ts", 0) < GEO_TTL_SECONDS:
                return cached
    except (json.JSONDecodeError, OSError):
        pass

    try:
        data = fetch_json("http://ip-api.com/json/?fields=status,lat,lon,city")
        if data.get("status") == "success":
            geo = {
                "lat": data["lat"],
                "lon": data["lon"],
                "city": data.get("city", ""),
                "ts": time.time(),
            }
            GEO_CACHE.parent.mkdir(parents=True, exist_ok=True)
            GEO_CACHE.write_text(json.dumps(geo))
            return geo
    except Exception:
        pass

    # Fall back to a stale cache rather than nothing.
    try:
        if GEO_CACHE.exists():
            return json.loads(GEO_CACHE.read_text())
    except (json.JSONDecodeError, OSError):
        pass
    return None


def load_last_result():
    try:
        if RESULT_CACHE.exists():
            return json.loads(RESULT_CACHE.read_text())
    except (json.JSONDecodeError, OSError):
        pass
    return None


def save_last_result(result):
    try:
        RESULT_CACHE.parent.mkdir(parents=True, exist_ok=True)
        RESULT_CACHE.write_text(json.dumps(result))
    except OSError:
        pass


def emit(text, tooltip, alt="cloudy"):
    print(json.dumps({"text": text, "tooltip": tooltip, "alt": alt}))


def emit_unavailable(reason):
    """Fall back to the last successful reading if we have one, instead
    of blanking the bar -- a single dropped request shouldn't erase a
    perfectly good, only-slightly-stale temperature for 15 minutes."""
    last = load_last_result()
    if last:
        tooltip = f"{last['tooltip']} (last known, {reason})"
        emit(last["text"], tooltip, last.get("alt", "cloudy"))
    else:
        emit("--°", f"Weather unavailable ({reason})", "cloudy")


def main():
    geo = get_location()
    if not geo:
        emit_unavailable("couldn't determine location")
        return

    try:
        weather = fetch_json(
            "https://api.open-meteo.com/v1/forecast"
            f"?latitude={geo['lat']}&longitude={geo['lon']}"
            "&current=temperature_2m,relative_humidity_2m,weather_code,is_day"
            "&timezone=auto"
        )
        cur = weather["current"]
    except Exception:
        emit_unavailable(f"fetch failed for {geo.get('city', 'current location')}")
        return

    temp = round(cur["temperature_2m"])
    humidity = cur["relative_humidity_2m"]
    code = cur["weather_code"]
    is_day = cur.get("is_day", 1)

    desc, alt = WMO_CODES.get(code, ("Unknown", "cloudy"))
    if alt == "clear" and not is_day:
        alt = "clear-night"

    city = geo.get("city", "")
    tooltip = f"{city} — {desc}, {humidity}% humidity" if city else f"{desc}, {humidity}% humidity"
    text = f"{temp}°C"

    save_last_result({"text": text, "tooltip": tooltip, "alt": alt})
    emit(text, tooltip, alt)


if __name__ == "__main__":
    try:
        main()
    except Exception as e:
        emit_unavailable(f"error: {e}")
        sys.exit(0)
